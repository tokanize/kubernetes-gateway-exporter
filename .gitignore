# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.out

# Dependency directories (remove the comment below to include it)
# vendor/

# OS Specific
.DS_Store
.AppleDouble
.LSOverride

# IDEs
.idea/
.vscode/
*.swp
*.swo

# CodeGraph Index Cache (Do not commit!)
.codegraph/

# AI Agent tooling: track only the shared OpenSpec commands/skills,
# ignore each agent's local state (auth, cache, settings.local.json, scratch).
.claude/*
!.claude/commands/
!.claude/skills/
.codex/*
!.codex/skills/
.gemini/*
!.gemini/commands/
!.gemini/skills/
scratch/
docs/node_modules/
